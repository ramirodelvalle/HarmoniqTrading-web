{
  "compilerOptions": {
    "paths": { "@/*": ["src/*"] },
    "types": ["vite/client"],
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "target": "ES2020",
    "module": "ESNext",
    "skipLibCheck": true,
    "jsx": "preserve",
    "baseUrl": "."
  },
  "include": ["src", "src/env.d.ts", "src/shims-vue.d.ts"]
}
